# Copy this file to .env and fill your own keys. Never commit .env
# Get a free key at https://www.pexels.com/api/
PEXELS_API_KEY=your_pexels_api_key_here

# Optional LLM for viral script writing (OpenAI-compatible).
# Works with OpenAI, Gemini OpenAI-endpoint, DeepSeek, Qwen, Groq, Ollama, OneAPI, LiteLLM.
# If left empty, the app uses the built-in local template (100% free, offline).
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# Optional defaults (any EdgeTTS voice, e.g. en-US-AriaNeural, en-GB-SoniaNeural)
TTS_VOICE=en-US-AriaNeural
TARGET_SECONDS=16
